spring.application.name=mindtrack-backend

# ─── Database Configuration ───────────────────────────────────────────────────
# Replace with your PostgreSQL connection details
spring.datasource.url=jdbc:postgresql://localhost:5432/mindtrack_db
spring.datasource.username=postgres
spring.datasource.password=YOUR_DB_PASSWORD_HERE
spring.datasource.driver-class-name=org.postgresql.Driver

# ─── JPA / Hibernate Configuration ───────────────────────────────────────────
spring.jpa.hibernate.ddl-auto=update
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect

# SQL logging must be disabled in production to prevent sensitive data exposure and performance issues.
# Local developers can enable SQL logs only temporarily for debugging (e.g. show-sql=true, format_sql=true, SQL=DEBUG).
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=false
logging.level.org.hibernate.SQL=WARN

# ─── JWT Configuration ────────────────────────────────────────────────────────
# Generate a secure 256-bit hex secret: openssl rand -hex 32
jwt.secret=YOUR_JWT_SECRET_HEX_32_BYTES_HERE
# Token expiry in milliseconds (604800000 = 7 days)
jwt.expiration=604800000

# ─── CORS Configuration ───────────────────────────────────────────────────────
# CORS: comma-separated allowed origins (no wildcard when credentials=true)
cors.allowed-origins=http://localhost:3000,http://localhost:3001

# AI Configuration
gemini.api.key=your_gemini_api_key_here
gemini.model=gemini-2.5-flash
